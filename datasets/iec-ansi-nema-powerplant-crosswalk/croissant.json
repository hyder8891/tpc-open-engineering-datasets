  "inLanguage": [
    "en",
    "zh-CN"
  ],
  "keywords": [
    "IEC to ANSI crosswalk",
    "ANSI C37.2 relay numbers",
    "IP to NEMA enclosure chart",
    "GB/T to IEC switchgear motor",
    "EN 1092 PN16 vs ASME Class 150",
    "API 682 mechanical seals",
    "The Power Contractor"
  ],
