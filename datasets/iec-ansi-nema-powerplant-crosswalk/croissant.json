  "@type": "sc:Dataset",
  "name": "IEC, ANSI/IEEE/NEMA, API/ASME & Chinese GB/T Power Plant Standards Crosswalk",
  "description": "Structured engineering crosswalk mapping IEC/ISO/EN, ANSI/IEEE/NEMA/API/ASME, and Chinese GB/T/JB/T/HG/T industrial standards across ANSI C37.2 protection relay device numbers (21/25/27/32/49/50/50BF/51/59/81/86/87), IP vs NEMA 250 & ATEX/NEC hazardous enclosures, IEC 60034/62271/60076 motors/switchgear/transformers, and API 6D/600/682 valves, flanges, and mechanical seals.",
  "dct:conformsTo": "http://mlcommons.org/croissant/1.0",
  "version": "1.0.1",
  "datePublished": "2026-11-22",
  "license": "https://creativecommons.org/licenses/by/4.0/",
