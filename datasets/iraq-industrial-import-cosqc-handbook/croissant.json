  "@type": "sc:Dataset",
  "name": "Iraq Industrial Import, HS 84/85/90 Customs & COSQC Pre-Shipment CoC Handbook",
  "description": "Structured trilingual (EN / MSA Arabic / Mandarin) engineering compliance dataset mapping 33 core HS6 industrial equipment categories across Chapters 84, 85, and 90 to Iraq COSQC pre-shipment Certificate of Conformity (CoC) rules, authorized inspection agencies (SGS, TUV Rheinland, Bureau Veritas, Intertek), CCPIT Certificate of Origin legalization, 50Hz grid nameplate rules, and Umm Qasr / Khor al-Zubair / BSR / BGW / EBL port clearance requirements.",
  "dct:conformsTo": "http://mlcommons.org/croissant/1.0",
  "version": "1.0.1",
  "datePublished": "2026-11-22",
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "url": "https://github.com/hyder8891/tpc-open-engineering-datasets/tree/main/datasets/iraq-industrial-import-cosqc-handbook",
  "inLanguage": [
    "en",
    "ar",
    "zh-CN"
  ],
  "keywords": [
    "Iraq customs",
    "COSQC Certificate of Conformity",
    "Umm Qasr port clearance",
    "HS 84 85 90 industrial equipment",
    "CCPIT Certificate of Origin",
    "power plant spare parts Iraq",
    "The Power Contractor"
